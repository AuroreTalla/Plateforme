CREATE DATABASE IF NOT EXISTS plateformeBD;

USE plateformeBD;

-- Table users
CREATE TABLE users (
    id BIGINT PRIMARY KEY AUTO_INCREMENT,
    name VARCHAR(255) NOT NULL,
    email VARCHAR(255) UNIQUE NOT NULL,
    password VARCHAR(255) NOT NULL,
    statut ENUM('ELEVE', 'PROFESSEUR', 'ADMIN') DEFAULT 'ELEVE',
    demande_professeur TINYINT(1) DEFAULT 0,
    email_verifie TINYINT(1) DEFAULT 0,
    date_inscription DATETIME(6) NOT NULL DEFAULT CURRENT_TIMESTAMP(6),
    lastseen DATETIME(6)
) ENGINE=InnoDB;

-- Table email_verification
CREATE TABLE email_verification (
    id BIGINT PRIMARY KEY AUTO_INCREMENT,
    code VARCHAR(255) NOT NULL,
    user_id BIGINT NOT NULL,
    date_creation DATETIME(6) NOT NULL DEFAULT CURRENT_TIMESTAMP(6),
    date_expiration DATETIME(6) NOT NULL DEFAULT CURRENT_TIMESTAMP(6),
    FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE
) ENGINE=InnoDB;

-- Table refresh_token
CREATE TABLE refresh_token (
    id BIGINT PRIMARY KEY AUTO_INCREMENT,
    valeur TEXT NOT NULL UNIQUE,
    expire BOOLEAN DEFAULT FALSE,
    creation DATETIME(6) NOT NULL DEFAULT CURRENT_TIMESTAMP(6),
    expiration DATETIME(6) NOT NULL DEFAULT CURRENT_TIMESTAMP(6),
    user_id BIGINT NOT NULL,
    FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE
) ENGINE=InnoDB;

-- Table jwt
CREATE TABLE jwt (
    id BIGINT PRIMARY KEY AUTO_INCREMENT,
    valeur VARCHAR(512) NOT NULL UNIQUE,
    desactive BOOLEAN DEFAULT FALSE,
    expire BOOLEAN DEFAULT FALSE,
    date_expiration DATETIME(6),
    user_id BIGINT NOT NULL,
    refresh_token_id BIGINT,
    FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE,
    FOREIGN KEY (refresh_token_id) REFERENCES refresh_token(id) ON DELETE CASCADE
) ENGINE=InnoDB;

-- Table groupe
CREATE TABLE groupe (
    id BIGINT PRIMARY KEY AUTO_INCREMENT,
    nom VARCHAR(255) NOT NULL UNIQUE
) ENGINE=InnoDB;

-- Table many-to-many users <-> groupe
CREATE TABLE groupe_users (
    user_id BIGINT NOT NULL,
    groupe_id BIGINT NOT NULL,
    PRIMARY KEY(user_id, groupe_id),
    FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE,
    FOREIGN KEY (groupe_id) REFERENCES groupe(id) ON DELETE CASCADE
) ENGINE=InnoDB;

-- Table message
CREATE TABLE message (
    id BIGINT PRIMARY KEY AUTO_INCREMENT,
    user_id BIGINT NOT NULL,
    groupe_id BIGINT NOT NULL,
    content VARCHAR(2000) NOT NULL,
    date_envoie DATETIME(6) NOT NULL DEFAULT CURRENT_TIMESTAMP(6),
    FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE,
    FOREIGN KEY (groupe_id) REFERENCES groupe(id) ON DELETE CASCADE
) ENGINE=InnoDB;

