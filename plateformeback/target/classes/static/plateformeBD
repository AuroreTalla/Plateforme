CREATE DATABASE IF NOT EXISTS plateformeBD;

USE plateformeBD;

-- Table users
CREATE TABLE users (
    id BIGINT PRIMARY KEY AUTO_INCREMENT,
    name VARCHAR(255) NOT NULL,
    email VARCHAR(255) UNIQUE NOT NULL,
    password VARCHAR(255) NOT NULL,
    statut ENUM('ELEVE', 'PROFESSEUR', 'ADMIN') DEFAULT 'ELEVE',
    email_verifie TINYINT(1) DEFAULT 0,
    date_inscription DATETIME(6) NOT NULL DEFAULT CURRENT_TIMESTAMP(6),
    lastseen DATETIME(6)
) ENGINE=InnoDB;

CREATE TABLE demandeProfessuer(
    id BIGINT PRIMARY KEY AUTO_INCREMENT,
    statut ENUM('EN_ATTENTE', 'VALIDEE', 'REFUSEE', 'REVOQUEE') DEFAULT 'EN_ATTENTE',
    user_id BIGINT NOT NULL,
    date_validation DATETIME(6) NULL,
    FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE
) ENGINE=InnoDB;


-- Table email_verification
CREATE TABLE email_verification (
    id BIGINT PRIMARY KEY AUTO_INCREMENT,
    code VARCHAR(255) NOT NULL,
    user_id BIGINT NOT NULL,
    date_creation DATETIME(6) NOT NULL DEFAULT CURRENT_TIMESTAMP(6),
    date_expiration DATETIME(6) NOT NULL DEFAULT CURRENT_TIMESTAMP(6),
    FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE
) ENGINE=InnoDB;

-- Table refresh_token
CREATE TABLE refresh_token (
    id BIGINT PRIMARY KEY AUTO_INCREMENT,
    valeur TEXT NOT NULL UNIQUE,
    expire BOOLEAN DEFAULT FALSE,
    creation DATETIME(6) NOT NULL DEFAULT CURRENT_TIMESTAMP(6),
    expiration DATETIME(6) NOT NULL DEFAULT CURRENT_TIMESTAMP(6),
    user_id BIGINT NOT NULL,
    FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE
) ENGINE=InnoDB;

-- Table jwt
CREATE TABLE jwt (
    id BIGINT PRIMARY KEY AUTO_INCREMENT,
    valeur VARCHAR(512) NOT NULL UNIQUE,
    desactive BOOLEAN DEFAULT FALSE,
    expire BOOLEAN DEFAULT FALSE,
    date_expiration DATETIME(6),
    user_id BIGINT NOT NULL,
    refresh_token_id BIGINT,
    FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE,
    FOREIGN KEY (refresh_token_id) REFERENCES refresh_token(id) ON DELETE CASCADE
) ENGINE=InnoDB;

-- Table message
CREATE TABLE message (
    id BIGINT PRIMARY KEY AUTO_INCREMENT,
    user_id BIGINT NOT NULL,
    groupe_id BIGINT NOT NULL,
    content VARCHAR(2000) NOT NULL,
    date_envoie DATETIME(6) NOT NULL DEFAULT CURRENT_TIMESTAMP(6),
    FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE,
    FOREIGN KEY (groupe_id) REFERENCES groupe(id) ON DELETE CASCADE
) ENGINE=InnoDB;

CREATE TABLE publication (
    id BIGINT PRIMARY KEY AUTO_INCREMENT,
    user_id BIGINT NOT NULL,
    groupe_id BIGINT NOT NULL,
    titre VARCHAR(255) NOT NULL,
    content TEXT,
    date_publication DATETIME(6) NOT NULL DEFAULT CURRENT_TIMESTAMP(6),
    statut ENUM('NON_RESOLUE', 'RESOLUE') NOT NULL DEFAULT 'NON_RESOLUE',
    FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE,
    FOREIGN KEY (groupe_id) REFERENCES groupe(id) ON DELETE CASCADE
) ENGINE=InnoDB;

CREATE TABLE reponse (
    id BIGINT PRIMARY KEY AUTO_INCREMENT,
    publication_id BIGINT NOT NULL,
    user_id BIGINT NOT NULL,
    content TEXT NOT NULL,
    validee_par_user_id BIGINT NULL,
    date_reponse DATETIME(6) NOT NULL DEFAULT CURRENT_TIMESTAMP(6),
    date_validation DATETIME(6) NULL,
    est_solution_proposee BOOLEAN NOT NULL DEFAULT FALSE,
    validee_par_admin BOOLEAN NOT NULL DEFAULT FALSE,
    FOREIGN KEY (publication_id) REFERENCES publication(id) ON DELETE CASCADE,
    FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE,
    FOREIGN KEY (validee_par_user_id) REFERENCES users(id) ON DELETE SET NULL
) ENGINE=InnoDB;

CREATE INDEX idx_publication_groupe ON publication(groupe_id);
CREATE INDEX idx_publication_statut ON publication(statut);
CREATE INDEX idx_reponse_publication ON reponse(publication_id);
/*Un index est une structure que MySQL construit sur une ou plusieurs colonnes d'une table donnée, 
pour accélérer les recherches/filtres sur cette colonne — un peu comme l'index alphabétique à la fin 
d'un livre : sans lui, MySQL doit lire ligne par ligne 
toute la table (table scan) pour trouver ce qu'il cherche ; avec lui, il saute directement aux bonnes lignes.*/

-- Table groupe
CREATE TABLE groupe (
    id BIGINT PRIMARY KEY AUTO_INCREMENT,
    nom VARCHAR(255) NOT NULL UNIQUE
) ENGINE=InnoDB;
-- Insertion de groupes de base
