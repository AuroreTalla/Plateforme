('Chimie');

-- Table many-to-many users <-> groupe
CREATE TABLE groupe_users (
    user_id BIGINT NOT NULL,
    groupe_id BIGINT NOT NULL,
    PRIMARY KEY(user_id, groupe_id),
    FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE,
    FOREIGN KEY (groupe_id) REFERENCES groupe(id) ON DELETE CASCADE
) ENGINE=InnoDB;

CREATE TABLE matiere (
    id BIGINT PRIMARY KEY AUTO_INCREMENT,
    nom VARCHAR(255) NOT NULL UNIQUE,
    description TEXT,
    groupe_id BIGINT NOT NULL UNIQUE,
    FOREIGN KEY (groupe_id) REFERENCES groupe(id) ON DELETE RESTRICT
) ENGINE=InnoDB;
INSERT INTO matiere (nom, description, groupe_id)
SELECT nom, description, id FROM groupe WHERE nom IN ('Mathématiques', 'Physique', 'Chimie');

CREATE TABLE cours (
    id BIGINT PRIMARY KEY AUTO_INCREMENT,
    matiere_id BIGINT NOT NULL,
    titre VARCHAR(255) NOT NULL,
    type ENUM('TEXTE', 'IMAGE', 'VIDEO') NOT NULL DEFAULT 'TEXTE',
    contenu TEXT,
    media_url VARCHAR(500),
    ordre INT NOT NULL DEFAULT 0,
    date_creation DATETIME(6) NOT NULL DEFAULT CURRENT_TIMESTAMP(6),
    FOREIGN KEY (matiere_id) REFERENCES matiere(id) ON DELETE CASCADE
) ENGINE=InnoDB;

CREATE TABLE exercice (
    id BIGINT PRIMARY KEY AUTO_INCREMENT,
    matiere_id BIGINT NOT NULL,
    titre VARCHAR(255) NOT NULL,
    type ENUM('TEXTE', 'IMAGE', 'VIDEO') NOT NULL DEFAULT 'TEXTE',
    contenu TEXT,
    media_url VARCHAR(500),
    ordre INT NOT NULL DEFAULT 0,
    date_creation DATETIME(6) NOT NULL DEFAULT CURRENT_TIMESTAMP(6),
    FOREIGN KEY (matiere_id) REFERENCES matiere(id) ON DELETE CASCADE
) ENGINE=InnoDB;

CREATE INDEX idx_cours_matiere ON cours(matiere_id);
CREATE INDEX idx_exercice_matiere ON exercice(matiere_id);
